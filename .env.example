# Server Configuration
PORT=3000
NODE_ENV=development

# ESP32 Device Authentication (Optional in dev, recommended in production)
# Header: X-API-Key: your-esp32-secret-api-key
DEVICE_API_KEY=esp32_glow_secret_key_9281

# Expected Device Identifier
DEVICE_ID=ESP32_CHASER_01

# Command Queue Expiration in seconds (stale commands expire after this time)
COMMAND_TIMEOUT_SECONDS=60

# Offline detection threshold in seconds (device considered offline if no poll/ack within this window)
OFFLINE_THRESHOLD_SECONDS=15

# Database path (defaults to ./database/glowcontrol.sqlite)
DATABASE_PATH=./database/glowcontrol.sqlite

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
