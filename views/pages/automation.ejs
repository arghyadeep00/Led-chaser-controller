<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight">Automation & Scheduling</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Configure automated effect cycling, intervals, and hardware autonomy behavior</p>
    </div>
    
    <div class="flex items-center gap-3">
      <span class="text-xs font-mono px-3 py-1.5 rounded-lg bg-navy-800 border border-navy-700 text-slate-300">
        Status: <strong class="<%= automation.enabled ? 'text-emerald-400' : 'text-slate-400' %>"><%= automation.enabled ? 'Auto-Cycling Active' : 'Manual Mode Active' %></strong>
      </span>
    </div>
  </div>

  <!-- Firmware Capability Alert (Explicitly identifying requirements) -->
  <div class="card p-5 border-l-4 border-l-secondary bg-navy-800/90">
    <div class="flex items-start gap-3.5">
      <div class="p-2 rounded-lg bg-secondary/15 text-secondary border border-secondary/30 mt-0.5">
        <i data-lucide="cpu" class="w-5 h-5"></i>
      </div>
      <div class="space-y-1.5 text-xs text-slate-300">
        <h4 class="text-sm font-semibold text-white">Firmware Compatibility Matrix</h4>
        <p class="leading-relaxed">
          The ESP32 firmware currently has an internal autonomous 10-second automatic effect-switching routine. 
          The backend safely coordinates commands without server blocking or restarts.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2 pt-2">
          <div class="p-2.5 rounded bg-navy-950 border border-navy-700 flex items-center gap-2">
            <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400 flex-shrink-0"></i>
            <span><strong>Native Hardware Auto:</strong> Toggling auto mode works with existing firmware (10s default).</span>
          </div>
          <div class="p-2.5 rounded bg-navy-950 border border-amber-500/40 flex items-center gap-2">
            <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-400 flex-shrink-0"></i>
            <span><strong>Custom Interval (<%= automation.intervalSeconds %>s):</strong> Dynamically modifying hardware interval requires Firmware v1.5 update.</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Main Settings Form Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

    <!-- Left: Automation Configuration (8 cols) -->
    <div class="card p-6 lg:col-span-8 space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-navy-700/60">
        <div class="flex items-center gap-2.5">
          <div class="p-2 rounded-lg bg-navy-900 border border-navy-700 text-accent">
            <i data-lucide="sliders" class="w-4 h-4"></i>
          </div>
          <div>
            <h3 class="text-sm font-semibold text-white uppercase tracking-wider">Cycle Configuration</h3>
            <p class="text-xs text-slate-400">Settings persist in SQLite and apply seamlessly across sessions</p>
          </div>
        </div>
      </div>

      <form id="automation-form" class="space-y-6">
        
        <!-- Toggle: Enable / Disable Automatic Mode -->
        <div class="flex items-center justify-between p-4 rounded-xl bg-navy-950 border border-navy-700/80">
          <div class="space-y-0.5">
            <label for="auto-mode-toggle" class="text-sm font-semibold text-white flex items-center gap-2">
              Automatic Effect Switching
              <span id="auto-state-pill" class="badge <%= automation.enabled ? 'badge-success' : 'badge-neutral' %> text-[10px]">
                <%= automation.enabled ? 'Enabled' : 'Disabled' %>
              </span>
            </label>
            <p class="text-xs text-slate-400">
              When enabled, the controller advances to the next pattern automatically at the set interval.
            </p>
          </div>

          <label class="relative inline-flex items-center cursor-pointer">
            <input 
              type="checkbox" 
              id="auto-mode-toggle" 
              class="sr-only peer"
              <%= automation.enabled ? 'checked' : '' %>
            >
            <div class="w-12 h-6 bg-navy-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-accent shadow-sm"></div>
          </label>
        </div>

        <!-- Interval Setting (in seconds) -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label for="auto-interval-input" class="text-xs font-mono font-semibold uppercase text-slate-300 tracking-wider">
              Cycle Switching Interval (Seconds)
            </label>
            <span class="text-xs font-mono text-accent font-bold">
              <span id="interval-display"><%= automation.intervalSeconds %></span> seconds
            </span>
          </div>

          <div class="space-y-2">
            <input 
              type="range" 
              id="auto-interval-input" 
              min="3" 
              max="120" 
              step="1" 
              value="<%= automation.intervalSeconds %>"
              class="w-full h-2.5 bg-navy-950 rounded-lg appearance-none cursor-pointer accent-sky-400 focus:outline-none"
            >
            <div class="flex justify-between text-[11px] font-mono text-slate-500">
              <span>3s (Rapid)</span>
              <span>10s (Firmware Default)</span>
              <span>30s</span>
              <span>60s</span>
              <span>120s (Slow)</span>
            </div>
          </div>
          <p class="text-[11px] text-slate-400">
            Current firmware default is 10 seconds. Modifying this persists to the backend without blocking the server.
          </p>
        </div>

        <!-- Animation Speed Setting (in ms) -->
        <div class="space-y-2 pt-2 border-t border-navy-700/60">
          <div class="flex items-center justify-between">
            <label for="auto-speed-input" class="text-xs font-mono font-semibold uppercase text-slate-300 tracking-wider">
              LED Animation Frame Speed (Milliseconds)
            </label>
            <span class="text-xs font-mono text-accent font-bold">
              <span id="auto-speed-display"><%= automation.speedMs %></span> ms
            </span>
          </div>

          <div class="space-y-2">
            <input 
              type="range" 
              id="auto-speed-input" 
              min="20" 
              max="2000" 
              step="10" 
              value="<%= automation.speedMs %>"
              class="w-full h-2.5 bg-navy-950 rounded-lg appearance-none cursor-pointer accent-sky-400 focus:outline-none"
            >
            <div class="flex justify-between text-[11px] font-mono text-slate-500">
              <span>20 ms</span>
              <span>150 ms (Normal)</span>
              <span>500 ms</span>
              <span>2000 ms</span>
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-4 flex items-center justify-end gap-3">
          <button type="submit" id="save-automation-btn" class="btn-primary text-xs py-2.5 px-6">
            <i data-lucide="save" class="w-4 h-4"></i>
            Save Automation Settings
          </button>
        </div>

      </form>
    </div>

    <!-- Right: Current Automation State Summary (4 cols) -->
    <div class="space-y-6 lg:col-span-4">
      
      <!-- Current State Card -->
      <div class="card p-6 space-y-4">
        <div class="flex items-center justify-between pb-3 border-b border-navy-700/60">
          <h3 class="text-sm font-semibold text-white uppercase tracking-wider flex items-center gap-2">
            <i data-lucide="info" class="w-4 h-4 text-accent"></i>
            Active State
          </h3>
          <span class="text-[11px] font-mono text-slate-400">Live</span>
        </div>

        <div class="space-y-3 text-xs">
          <div class="flex justify-between items-center py-1.5 border-b border-navy-800">
            <span class="text-slate-400">Operating Mode</span>
            <span id="summary-mode" class="font-bold <%= automation.enabled ? 'text-emerald-400' : 'text-slate-300' %>">
              <%= automation.enabled ? 'Automatic Cycle' : 'Manual Lock' %>
            </span>
          </div>

          <div class="flex justify-between items-center py-1.5 border-b border-navy-800">
            <span class="text-slate-400">Active Effect</span>
            <span class="font-mono text-accent font-semibold">
              #<%= automation.currentEffect %> of <%= automation.totalEffects %>
            </span>
          </div>

          <div class="flex justify-between items-center py-1.5 border-b border-navy-800">
            <span class="text-slate-400">Cycle Interval</span>
            <span class="font-mono text-white font-semibold" id="summary-interval">
              <%= automation.intervalSeconds %> seconds
            </span>
          </div>

          <div class="flex justify-between items-center py-1.5 border-b border-navy-800">
            <span class="text-slate-400">Animation Clock</span>
            <span class="font-mono text-white font-semibold" id="summary-speed">
              <%= automation.speedMs %> ms
            </span>
          </div>

          <div class="flex justify-between items-center py-1.5">
            <span class="text-slate-400">Persistence Engine</span>
            <span class="font-mono text-emerald-400 text-[11px]">SQLite (WAL)</span>
          </div>
        </div>

        <div class="p-3 rounded-lg bg-navy-950/70 border border-navy-700/60 text-[11px] text-slate-400 leading-relaxed">
          <span class="text-white font-semibold">Autonomous Behavior:</span> Even if the Node.js server is stopped or Wi-Fi drops, the ESP32 keeps executing locally stored patterns smoothly.
        </div>
      </div>

    </div>

  </div>
</div>
