<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold text-white tracking-tight">Command History</h1>
      <p class="text-xs sm:text-sm text-slate-400 mt-1">Honest lifecycle audit of submitted, delivered, acknowledged, and expired commands</p>
    </div>
    
    <div class="flex items-center gap-3">
      <button id="purge-expired-btn" class="btn-secondary text-xs" title="Remove expired commands from SQLite">
        <i data-lucide="trash-2" class="w-4 h-4 text-slate-400"></i>
        Purge Expired
      </button>
      <button id="refresh-history-btn" class="btn-primary text-xs">
        <i data-lucide="refresh-cw" class="w-4 h-4"></i>
        Refresh History
      </button>
    </div>
  </div>

  <!-- Lifecycle Stage Flow Info Banner -->
  <div class="card p-4 bg-navy-900/60 border-navy-700/60">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 text-xs">
      <div class="flex items-center gap-2">
        <span class="font-mono uppercase font-semibold text-accent text-[11px]">Command Lifecycle:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:gap-4 font-mono text-[11px]">
        <span class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-amber-500/10 text-amber-400 border border-amber-500/30">
          <i data-lucide="clock" class="w-3 h-3"></i> 1. Submitted (Pending)
        </span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-slate-600 hidden sm:inline"></i>
        <span class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-sky-500/10 text-sky-400 border border-sky-500/30">
          <i data-lucide="radio" class="w-3 h-3"></i> 2. Delivered (Polled)
        </span>
        <i data-lucide="arrow-right" class="w-3.5 h-3.5 text-slate-600 hidden sm:inline"></i>
        <span class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">
          <i data-lucide="check-check" class="w-3 h-3"></i> 3. Executed & Acked
        </span>
      </div>
    </div>
  </div>

  <!-- Filters & Search Toolbar -->
  <div class="card p-4 space-y-3">
    <div class="flex flex-col md:flex-row items-center justify-between gap-3">
      <!-- Search Input -->
      <div class="relative flex-1 w-full">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
        <input 
          type="text" 
          id="history-search-input" 
          value="<%= searchQuery %>"
          placeholder="Search by command ID, name, or value..." 
          class="w-full bg-navy-950 border border-navy-700 rounded-lg pl-10 pr-4 py-2 text-xs sm:text-sm text-slate-200 placeholder-slate-500 focus:outline-none focus:border-accent transition-colors"
        >
      </div>

      <!-- Status Filter Tabs -->
      <div class="flex items-center gap-1.5 overflow-x-auto w-full md:w-auto text-xs">
        <% 
          const filterOptions = [
            { id: 'all', label: 'All Statuses' },
            { id: 'acknowledged', label: 'Acknowledged' },
            { id: 'delivered', label: 'Delivered' },
            { id: 'pending', label: 'Pending' },
            { id: 'expired', label: 'Expired' },
            { id: 'failed', label: 'Failed' }
          ];
        %>
        <% filterOptions.forEach(opt => { 
          const isSelected = currentFilter === opt.id;
        %>
          <a 
            href="/history?status=<%= opt.id %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"
            class="px-3 py-1.5 rounded-lg border whitespace-nowrap transition-colors <%= isSelected ? 'bg-accent/15 text-accent border-accent/40 font-semibold' : 'bg-navy-950 text-slate-400 border-navy-700 hover:text-slate-200 hover:bg-navy-900' %>"
          >
            <%= opt.label %>
          </a>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Command History Table -->
  <div class="card overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="text-[11px] font-mono uppercase bg-navy-900 text-slate-400 border-b border-navy-700/70">
          <tr>
            <th class="py-3 px-4">Command ID</th>
            <th class="py-3 px-4">Command</th>
            <th class="py-3 px-4">Payload Value</th>
            <th class="py-3 px-4">Origin</th>
            <th class="py-3 px-4">Submitted Time</th>
            <th class="py-3 px-4">Delivered Time</th>
            <th class="py-3 px-4">Acknowledged Time</th>
            <th class="py-3 px-4">Lifecycle Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-navy-700/50 font-mono">
          <% if (history.items && history.items.length > 0) { %>
            <% history.items.forEach(cmd => { %>
              <tr class="hover:bg-navy-750/30 transition-colors">
                <td class="py-3 px-4 font-mono text-[11px] text-slate-300 font-semibold truncate max-w-[140px]" title="<%= cmd.id %>">
                  <%= cmd.id %>
                </td>
                <td class="py-3 px-4 font-semibold text-white">
                  <span class="px-2 py-0.5 rounded bg-navy-950 border border-navy-700 text-accent font-sans text-xs">
                    <%= cmd.command %>
                  </span>
                </td>
                <td class="py-3 px-4 text-slate-200">
                  <%= cmd.value !== null ? cmd.value : '—' %>
                </td>
                <td class="py-3 px-4 text-slate-400 font-sans text-[11px]">
                  <%= cmd.origin %>
                </td>
                <td class="py-3 px-4 text-slate-400 text-[11px]">
                  <%= new Date(cmd.created_at).toLocaleString() %>
                </td>
                <td class="py-3 px-4 text-slate-400 text-[11px]">
                  <%= cmd.delivered_at ? new Date(cmd.delivered_at).toLocaleTimeString() : '—' %>
                </td>
                <td class="py-3 px-4 text-slate-400 text-[11px]">
                  <%= cmd.acknowledged_at ? new Date(cmd.acknowledged_at).toLocaleTimeString() : '—' %>
                </td>
                <td class="py-3 px-4">
                  <% if (cmd.status === 'acknowledged') { %>
                    <span class="badge badge-success text-[11px]">
                      <i data-lucide="check-check" class="w-3 h-3"></i> Executed by ESP32
                    </span>
                  <% } else if (cmd.status === 'delivered') { %>
                    <span class="badge badge-info text-[11px]">
                      <i data-lucide="radio" class="w-3 h-3"></i> Delivered (Awaiting Ack)
                    </span>
                  <% } else if (cmd.status === 'pending') { %>
                    <span class="badge badge-warning text-[11px]">
                      <i data-lucide="clock" class="w-3 h-3"></i> Submitted (In Queue)
                    </span>
                  <% } else if (cmd.status === 'expired') { %>
                    <span class="badge badge-neutral text-[11px] text-slate-400" title="<%= cmd.error_message || '' %>">
                      <i data-lucide="hourglass" class="w-3 h-3"></i> Expired in Queue
                    </span>
                  <% } else { %>
                    <span class="badge badge-error text-[11px]">
                      <i data-lucide="alert-circle" class="w-3 h-3"></i> Failed
                    </span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="py-12 text-center text-slate-500 font-sans">
                <i data-lucide="inbox" class="w-8 h-8 mx-auto mb-2 text-slate-600"></i>
                <p class="text-sm font-medium text-slate-400">No commands found matching this filter criteria.</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <!-- Pagination Footer -->
    <div class="p-4 border-t border-navy-700/60 bg-navy-900/40 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
      <div class="text-slate-400">
        Showing <span class="font-bold text-white"><%= history.items.length %></span> of <span class="font-bold text-white"><%= history.total %></span> recorded commands
      </div>

      <div class="flex items-center gap-2">
        <% if (history.page > 1) { %>
          <a 
            href="/history?page=<%= history.page - 1 %>&status=<%= currentFilter %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"
            class="btn-secondary text-xs py-1.5 px-3"
          >
            <i data-lucide="chevron-left" class="w-3.5 h-3.5"></i> Previous
          </a>
        <% } %>

        <span class="font-mono text-slate-300 px-2">
          Page <%= history.page %> of <%= history.totalPages %>
        </span>

        <% if (history.page < history.totalPages) { %>
          <a 
            href="/history?page=<%= history.page + 1 %>&status=<%= currentFilter %><%= searchQuery ? '&search=' + encodeURIComponent(searchQuery) : '' %>"
            class="btn-secondary text-xs py-1.5 px-3"
          >
            Next <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
          </a>
        <% } %>
      </div>
    </div>
  </div>

</div>
