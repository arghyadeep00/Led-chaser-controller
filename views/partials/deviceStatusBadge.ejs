<%
  const isOnline = device && device.isOnline;
  const isSimulated = device && device.isSimulated;
  const statusLabel = device ? device.statusLabel : 'Unknown';
  const wifiStatus = device ? device.wifiStatus : 'Unknown';
%>

<div class="flex items-center gap-3">
  <!-- Device Connection Status Badge -->
  <div id="device-status-badge" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold border transition-all duration-300
    <%= isSimulated ? 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30' : (isOnline ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30' : 'bg-rose-500/10 text-rose-400 border-rose-500/30') %>">
    <span class="relative flex h-2.5 w-2.5">
      <% if (isOnline || isSimulated) { %>
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 <%= isSimulated ? 'bg-cyan-400' : 'bg-emerald-400' %>"></span>
      <% } %>
      <span class="relative inline-flex rounded-full h-2.5 w-2.5 <%= isSimulated ? 'bg-cyan-400' : (isOnline ? 'bg-emerald-500' : 'bg-rose-500') %>"></span>
    </span>
    <span id="device-status-text" class="tracking-wide">
      <%= statusLabel %>
    </span>
  </div>

  <!-- Wi-Fi Status Badge -->
  <div id="wifi-status-badge" class="hidden sm:inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-full text-xs font-medium border <%= (wifiStatus.includes('Connected')) ? 'bg-slate-800 text-slate-300 border-navy-600' : 'bg-rose-950/30 text-rose-400 border-rose-900/40' %>">
    <i data-lucide="<%= (wifiStatus.includes('Connected')) ? 'wifi' : 'wifi-off' %>" class="w-3.5 h-3.5 <%= (wifiStatus.includes('Connected')) ? 'text-accent' : 'text-rose-400' %>"></i>
    <span id="wifi-status-text"><%= wifiStatus %></span>
  </div>
</div>
