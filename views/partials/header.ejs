<header class="h-16 bg-navy-900/90 backdrop-blur-md border-b border-navy-700/70 sticky top-0 z-30 px-4 sm:px-6 flex items-center justify-between">
  <!-- Left Side: Mobile Menu Button & App Brand -->
  <div class="flex items-center gap-3">
    <button 
      id="mobile-sidebar-toggle" 
      class="lg:hidden p-2 rounded-lg text-slate-400 hover:text-slate-100 hover:bg-navy-800 focus:outline-none"
      aria-label="Toggle Navigation Menu"
    >
      <i data-lucide="menu" class="w-5 h-5"></i>
    </button>

    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-accent to-secondary flex items-center justify-center shadow-glow-cyan">
        <i data-lucide="sparkles" class="w-4 h-4 text-navy-950"></i>
      </div>
      <div>
        <span class="text-lg font-bold tracking-tight text-white flex items-center gap-1.5">
          GlowControl
          <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-accent/20 text-accent font-semibold border border-accent/30">IoT</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Center/Right: Device Status & Actions -->
  <div class="flex items-center gap-3 sm:gap-5">
    <!-- Device Status Badge Partial -->
    <%- include('./deviceStatusBadge') %>

    <!-- Last Sync Timestamp -->
    <div class="hidden md:flex flex-col text-right">
      <span class="text-[10px] uppercase text-slate-500 font-mono tracking-wider">Last Sync</span>
      <span id="last-sync-time" class="text-xs font-mono text-slate-300">
        <%= (device && device.lastCommunicationTime) ? new Date(device.lastCommunicationTime).toLocaleTimeString() : 'Never' %>
      </span>
    </div>

    <!-- Simulator Toggle Button (Quick Switch) -->
    <button
      id="quick-simulator-btn"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium border transition-colors <%= (device && device.isSimulated) ? 'bg-cyan-500/20 text-cyan-300 border-cyan-500/50 hover:bg-cyan-500/30' : 'bg-navy-800 text-slate-400 border-navy-700 hover:text-slate-200 hover:bg-navy-700' %>"
      title="Toggle Built-in Virtual ESP32 Simulator for local testing"
    >
      <i data-lucide="cpu" class="w-3.5 h-3.5 <%= (device && device.isSimulated) ? 'text-accent' : '' %>"></i>
      <span class="hidden sm:inline"><%= (device && device.isSimulated) ? 'Sim Active' : 'Demo Mode' %></span>
    </button>

    <!-- User Profile Placeholder -->
    <div class="flex items-center gap-2 pl-2 sm:pl-3 border-l border-navy-700/60">
      <div class="w-8 h-8 rounded-full bg-navy-800 border border-navy-600 flex items-center justify-center text-slate-300 font-mono text-xs font-semibold" title="Administrator">
        <i data-lucide="user" class="w-4 h-4"></i>
      </div>
    </div>
  </div>
</header>
