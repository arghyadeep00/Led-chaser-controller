<%
  const pins = [
    { num: 1, pin: 16, label: 'LED 1' },
    { num: 2, pin: 17, label: 'LED 2' },
    { num: 3, pin: 18, label: 'LED 3' },
    { num: 4, pin: 19, label: 'LED 4' },
    { num: 5, pin: 21, label: 'LED 5' }
  ];
  const states = (device && device.ledStates) || [0, 0, 0, 0, 0];
  const isOnline = device && device.isOnline;
  const isSimulated = device && device.isSimulated;
%>

<div class="card p-5 relative overflow-hidden" id="five-led-panel">
  <!-- Header Info -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-3 border-b border-navy-700/60">
    <div class="flex items-center gap-2.5">
      <div class="p-2 rounded-lg bg-navy-900 border border-navy-700 text-accent">
        <i data-lucide="zap" class="w-4 h-4"></i>
      </div>
      <div>
        <h3 class="text-sm font-semibold text-slate-100 uppercase tracking-wider">5-LED Hardware Bus Indicator</h3>
        <p class="text-xs text-slate-400">GPIO Pins: 16, 17, 18, 19, 21 &bull; ESP32 Output Array</p>
      </div>
    </div>

    <!-- Data source disclosure label -->
    <div class="flex items-center gap-2">
      <% if (isSimulated) { %>
        <span class="badge badge-info text-[11px] py-0.5">
          <i data-lucide="cpu" class="w-3 h-3"></i> Simulated Hardware Bus
        </span>
      <% } else if (isOnline) { %>
        <span class="badge badge-success text-[11px] py-0.5">
          <i data-lucide="radio" class="w-3 h-3"></i> Live Telemetry State
        </span>
      <% } else { %>
        <span class="badge badge-neutral text-[11px] py-0.5 text-slate-400">
          <i data-lucide="power-off" class="w-3 h-3"></i> Standby (Device Offline)
        </span>
      <% } %>
    </div>
  </div>

  <!-- LED Display Visualizer -->
  <div class="bg-navy-950/80 rounded-xl p-6 border border-navy-700/50 flex flex-col items-center justify-center">
    <div class="flex items-center justify-center gap-4 sm:gap-8 md:gap-12 w-full max-w-xl py-4">
      <% pins.forEach((p, idx) => { 
        const isActive = states[idx] === 1;
      %>
        <div class="flex flex-col items-center gap-2.5 group">
          <!-- Pin Label -->
          <span class="text-[11px] font-mono text-slate-400 font-semibold tracking-wider">GPIO <%= p.pin %></span>

          <!-- The Glowing LED Circle -->
          <div 
            id="led-indicator-<%= p.num %>" 
            class="led-node <%= isActive ? 'active-led' : '' %>"
            title="LED <%= p.num %> (GPIO <%= p.pin %>): <%= isActive ? 'HIGH (3.3V ON)' : 'LOW (0V OFF)' %>"
          >
            <span class="z-10"><%= p.num %></span>
          </div>

          <!-- Status Text -->
          <span 
            id="led-state-text-<%= p.num %>"
            class="text-[10px] font-mono font-medium <%= isActive ? 'text-accent' : 'text-slate-500' %>"
          >
            <%= isActive ? 'HIGH' : 'LOW' %>
          </span>
        </div>
      <% }); %>
    </div>

    <div class="mt-4 pt-3 w-full border-t border-navy-800/80 flex flex-wrap items-center justify-between text-xs text-slate-400 px-2">
      <div class="flex items-center gap-4">
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-accent shadow-glow-cyan"></span> Active (HIGH)
        </span>
        <span class="flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-navy-700"></span> Idle (LOW)
        </span>
      </div>
      <div class="font-mono text-[11px] text-slate-500">
        Active Pattern: <span id="active-effect-pill" class="text-accent font-semibold"><%= device ? device.currentEffectName : 'Forward Chase' %></span>
      </div>
    </div>
  </div>
</div>
