<div class="min-h-[60vh] flex flex-col items-center justify-center text-center px-4">
  <div class="w-16 h-16 rounded-2xl bg-navy-800 border border-navy-700 flex items-center justify-center text-accent mb-4 shadow-glow-cyan">
    <i data-lucide="compass" class="w-8 h-8"></i>
  </div>
  <h1 class="text-3xl font-bold tracking-tight text-white mb-2">404 - Page Not Found</h1>
  <p class="text-sm text-slate-400 max-w-md mb-6">
    The requested dashboard route <code class="px-1.5 py-0.5 rounded bg-navy-900 border border-navy-700 text-accent font-mono text-xs"><%= typeof url !== 'undefined' ? url : '' %></code> does not exist on this GlowControl node.
  </p>
  <a href="/" class="btn-primary">
    <i data-lucide="arrow-left" class="w-4 h-4"></i>
    Back to Overview
  </a>
</div>
