<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'GlowControl — ESP32 LED Dashboard' %></title>
  
  <!-- Local compiled Tailwind CSS -->
  <link rel="stylesheet" href="/css/styles.css?v=1.0.0">
  
  <!-- Favicon svg -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2338BDF8' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polygon points='12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2'></polygon></svg>">
</head>
<body class="bg-navy-950 text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-accent selection:text-navy-950">

  <!-- Sidebar Partial -->
  <%- include('../partials/sidebar') %>

  <!-- Main Content Wrapper (offset by sidebar on desktop) -->
  <div class="lg:pl-64 flex flex-col min-h-screen flex-1">
    
    <!-- Top Header Partial -->
    <%- include('../partials/header') %>

    <!-- Page Body Container -->
    <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-7xl w-full mx-auto">
      <%- body %>
    </main>

    <!-- Footer Partial -->
    <%- include('../partials/footer') %>
  </div>

  <!-- Toast Notification System -->
  <%- include('../partials/toast') %>

  <!-- Confirmation Modal -->
  <%- include('../partials/confirmModal') %>

  <!-- Vendor Scripts (Served locally, zero CDN dependencies) -->
  <script src="/js/vendor/lucide.min.js"></script>
  <script src="/js/vendor/chart.umd.js"></script>

  <!-- Core App Scripts -->
  <script src="/js/main.js"></script>
  
  <!-- Page-specific script hook -->
  <% if (typeof script !== 'undefined') { %>
    <script src="<%= script %>"></script>
  <% } %>
</body>
</html>
