{
  "name": "glowcontrol-esp32-dashboard",
  "version": "1.0.0",
  "description": "Professional Web Dashboard for ESP32 5-LED 50-Effect Lighting Controller",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./public/css/tailwind.css -o ./public/css/styles.css --watch",
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "esp32",
    "led-controller",
    "iot-dashboard",
    "express",
    "ejs",
    "tailwind"
  ],
  "author": "GlowControl",
  "license": "MIT",
  "dependencies": {
    "chart.js": "^4.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "lucide": "^0.475.0",
    "morgan": "^1.10.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
